generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STOREKEEPER
  SELLER
  VIEWER
}

enum MovementType {
  PURCHASE_IN
  PRODUCTION_IN
  SALE_OUT
  LOSS_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER
}

enum ProductionStage {
  SOWING
  GERMINATION
  GROWING
  READY
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
}

enum PaymentStatus {
  PAID
  CREDIT
}

enum CustomerType {
  INDIVIDUAL
  LANDSCAPER
  MUNICIPALITY
}

model User {
  id           String              @id @default(cuid())
  name         String
  email        String              @unique
  passwordHash String
  role         UserRole            @default(VIEWER)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  movements    InventoryMovement[]
  sales        Sale[]
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameAr    String
  nameFr    String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String              @id @default(cuid())
  sku           String              @unique
  nameAr        String
  nameFr        String
  scientific    String?
  categoryId    String
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  size          String
  unit          String              @default("piece")
  purchasePrice Decimal             @db.Decimal(12, 3)
  salePrice     Decimal             @db.Decimal(12, 3)
  minimumStock  Int                 @default(0)
  homeLocation  String              @default("مخزن رئيسي")
  imageUrl      String?
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  movements     InventoryMovement[]
  batches       ProductionBatch[]
  purchaseLines PurchaseOrderLine[]
  saleLines     SaleLine[]

  @@index([categoryId, active])
  @@index([nameAr, nameFr])
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  city      String
  type      String
  phone     String
  email     String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  orders    PurchaseOrder[]
}

model Customer {
  id            String       @id @default(cuid())
  name          String
  type          CustomerType
  phone         String
  email         String?
  openingCredit Decimal      @default(0) @db.Decimal(12, 3)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  sales         Sale[]
}

model InventoryMovement {
  id                  String             @id @default(cuid())
  productId           String
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  type                MovementType
  quantity            Int
  reason              String?
  reference           String?
  fromLocation        String?
  toLocation          String?
  effectiveAt         DateTime           @default(now())
  createdAt           DateTime           @default(now())
  createdById         String?
  createdBy           User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  purchaseOrderLineId String?            @unique
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  saleLineId          String?
  saleLine            SaleLine?          @relation(fields: [saleLineId], references: [id], onDelete: SetNull)

  @@index([productId, effectiveAt])
  @@index([type, effectiveAt])
  @@index([reference])
}

model ProductionBatch {
  id                String          @id @default(cuid())
  code              String          @unique
  seedType          String
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  sowingDate        DateTime
  quantitySown      Int
  quantityLost      Int             @default(0)
  stage             ProductionStage @default(SOWING)
  expectedReadyDate DateTime
  readyAt           DateTime?
  createdAt         DateTime        @default(now())

  @@index([stage, expectedReadyDate])
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  code       String              @unique
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status     PurchaseOrderStatus @default(DRAFT)
  createdAt  DateTime            @default(now())
  sentAt     DateTime?
  receivedAt DateTime?
  lines      PurchaseOrderLine[]

  @@index([status, createdAt])
}

model PurchaseOrderLine {
  id        String             @id @default(cuid())
  orderId   String
  order     PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal            @db.Decimal(12, 3)
  movement  InventoryMovement?
}

model Sale {
  id          String        @id @default(cuid())
  code        String        @unique
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment     PaymentStatus
  createdAt   DateTime      @default(now())
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines       SaleLine[]

  @@index([customerId, createdAt])
  @@index([createdAt])
}

model SaleLine {
  id        String              @id @default(cuid())
  saleId    String
  sale      Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal             @db.Decimal(12, 3)
  movements InventoryMovement[]
}

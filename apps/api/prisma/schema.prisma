generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STOREKEEPER
  SELLER
  PURCHASING
  NURSERY_WORKER
  ACCOUNTANT
  VIEWER
}

enum MovementType {
  PURCHASE_IN
  PRODUCTION_IN
  SALE_OUT
  SALE_RETURN_IN
  LOSS_OUT
  INTERNAL_ISSUE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER
}

enum ProductionStage {
  SOWING
  GERMINATION
  GROWING
  READY
}

enum ProductionTaskType {
  PLANTING
  WATERING
  FERTILIZING
  TREATMENT
  PRUNING
  INSPECTION
  OTHER
}

enum ProductionTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum ProductionCareType {
  WATERING
  FERTILIZING
  TREATMENT
  PRUNING
  OBSERVATION
  OTHER
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
}

enum SupplierInvoiceStatus {
  RECORDED
  REVIEWED
}

enum SupplierReturnStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AdjustmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductionProposalStatus {
  NONE
  PENDING
  VERIFIED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PAID
  CREDIT
}

enum SaleApprovalStatus {
  APPROVED
  PENDING
  REJECTED
}

enum SalesReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum CashLedgerEntryType {
  SALE
  CUSTOMER_PAYMENT
  REFUND
  SUPPLIER_PAYMENT
  EXPENSE_PAYMENT
}

enum AccountingPaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
}

enum ExpenseStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum CustomerType {
  INDIVIDUAL
  LANDSCAPER
  MUNICIPALITY
}

model User {
  id                       String              @id @default(cuid())
  name                     String
  email                    String              @unique
  passwordHash             String
  authVersion              Int                 @default(0)
  role                     UserRole            @default(VIEWER)
  active                   Boolean             @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  movements                InventoryMovement[]
  sales                    Sale[]
  recordedPayments         CustomerPayment[]
  auditEvents              AuditLog[]
  purchaseRequests         PurchaseOrder[]     @relation("PurchaseRequester")
  purchaseApprovals        PurchaseOrder[]     @relation("PurchaseApprover")
  purchaseRejections       PurchaseOrder[]     @relation("PurchaseRejector")
  purchaseSends            PurchaseOrder[]     @relation("PurchaseSender")
  purchaseReceipts         PurchaseReceipt[]
  supplierQuotes           SupplierQuote[]     @relation("SupplierQuoteRecorder")
  supplierInvoices         SupplierInvoice[]   @relation("SupplierInvoiceRecorder")
  reviewedSupplierInvoices SupplierInvoice[]   @relation("SupplierInvoiceReviewer")
  supplierReturns          SupplierReturn[]    @relation("SupplierReturnRequester")
  reviewedSupplierReturns  SupplierReturn[]    @relation("SupplierReturnReviewer")
  adjustmentRequests       AdjustmentRequest[] @relation("AdjustmentRequester")
  adjustmentApprovals      AdjustmentRequest[] @relation("AdjustmentApprover")
  adjustmentRejections     AdjustmentRequest[] @relation("AdjustmentRejector")
  stockCounts              StockCount[]        @relation("StockCountRecorder")
  productionBatches        ProductionBatch[]   @relation("ProductionCreator")
  productionProposals      ProductionBatch[]   @relation("ProductionProposer")
  productionVerifications  ProductionBatch[]   @relation("ProductionVerifier")
  productionApprovals      ProductionBatch[]   @relation("ProductionApprover")
  productionRejections     ProductionBatch[]   @relation("ProductionRejector")
  assignedProductionTasks ProductionTask[]    @relation("ProductionTaskAssignee")
  createdProductionTasks  ProductionTask[]    @relation("ProductionTaskCreator")
  productionCareLogs      ProductionCareLog[] @relation("ProductionCareRecorder")
  productionLossReports   ProductionLoss[]    @relation("ProductionLossReporter")
  cashSessions             CashSession[]       @relation("CashSessionOwner")
  closedCashSessions       CashSession[]       @relation("CashSessionCloser")
  cashEntries              CashLedgerEntry[]
  supplierPayments         SupplierPayment[]    @relation("SupplierPaymentRecorder")
  expenseRecords           Expense[]            @relation("ExpenseRecorder")
  expenseReviews           Expense[]            @relation("ExpenseReviewer")
  expensePayments          ExpensePayment[]     @relation("ExpensePaymentRecorder")
  reviewedCashSessions     CashSession[]        @relation("CashSessionReviewer")
  approvedCashVariances    CashSession[]        @relation("CashVarianceApprover")
  vatRates                 VatRate[]
  reviewedSales            Sale[]               @relation("SaleReviewer")
  requestedReturns         SalesReturn[]       @relation("ReturnRequester")
  approvedReturns          SalesReturn[]       @relation("ReturnApprover")
  rejectedReturns          SalesReturn[]       @relation("ReturnRejector")
  verifiedReturns          SalesReturn[]       @relation("ReturnVerifier")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameAr    String
  nameFr    String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id                  String               @id @default(cuid())
  sku                 String               @unique
  nameAr              String
  nameFr              String
  scientific          String?
  categoryId          String
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  size                String
  unit                String               @default("piece")
  purchasePrice       Decimal              @db.Decimal(12, 3)
  salePrice           Decimal              @db.Decimal(12, 3)
  minimumStock        Int                  @default(0)
  homeLocation        String               @default("مخزن رئيسي")
  imageUrl            String?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  movements           InventoryMovement[]
  batches             ProductionBatch[]
  purchaseLines       PurchaseOrderLine[]
  saleLines           SaleLine[]
  adjustmentRequests  AdjustmentRequest[]
  stockCounts         StockCount[]
  supplierQuoteLines  SupplierQuoteLine[]
  supplierReturnLines SupplierReturnLine[]

  @@index([categoryId, active])
  @@index([nameAr, nameFr])
}

model Supplier {
  id        String            @id @default(cuid())
  name      String
  city      String
  type      String
  phone     String
  email     String?
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  orders    PurchaseOrder[]
  quotes    SupplierQuote[]
  invoices  SupplierInvoice[]
  returns   SupplierReturn[]
}

model Customer {
  id            String            @id @default(cuid())
  name          String
  type          CustomerType
  phone         String
  email         String?
  openingCredit Decimal           @default(0) @db.Decimal(12, 3)
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  sales         Sale[]
  payments      CustomerPayment[]
}

model InventoryMovement {
  id                    String               @id @default(cuid())
  productId             String
  product               Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  type                  MovementType
  quantity              Int
  reason                String?
  reference             String?
  fromLocation          String?
  toLocation            String?
  effectiveAt           DateTime             @default(now())
  createdAt             DateTime             @default(now())
  createdById           String?
  createdBy             User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  purchaseOrderLineId   String?              @unique
  purchaseOrderLine     PurchaseOrderLine?   @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  purchaseReceiptLineId String?
  purchaseReceiptLine   PurchaseReceiptLine? @relation(fields: [purchaseReceiptLineId], references: [id], onDelete: Restrict)
  saleLineId            String?
  saleLine              SaleLine?            @relation(fields: [saleLineId], references: [id], onDelete: SetNull)
  adjustmentRequestId   String?              @unique
  adjustmentRequest     AdjustmentRequest?   @relation(fields: [adjustmentRequestId], references: [id], onDelete: Restrict)
  salesReturnLineId     String?              @unique
  salesReturnLine       SalesReturnLine?     @relation(fields: [salesReturnLineId], references: [id], onDelete: Restrict)

  @@index([productId, effectiveAt])
  @@index([type, effectiveAt])
  @@index([reference])
}

model ProductionBatch {
  id                String                   @id @default(cuid())
  code              String                   @unique
  seedType          String
  productId         String
  product           Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  sowingDate        DateTime
  quantitySown      Int
  quantityLost      Int                      @default(0)
  stage             ProductionStage          @default(SOWING)
  expectedReadyDate DateTime
  readyAt           DateTime?
  createdById       String?
  createdBy         User?                    @relation("ProductionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  readyQuantity     Int?
  proposalStatus    ProductionProposalStatus @default(NONE)
  proposedById      String?
  proposedBy        User?                    @relation("ProductionProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  proposedAt        DateTime?
  verifiedById      String?
  verifiedBy        User?                    @relation("ProductionVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  verifiedAt        DateTime?
  approvedById      String?
  approvedBy        User?                    @relation("ProductionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt        DateTime?
  rejectedById      String?
  rejectedBy        User?                    @relation("ProductionRejector", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime                 @default(now())
  tasks             ProductionTask[]
  careLogs          ProductionCareLog[]
  lossReports       ProductionLoss[]

  @@index([stage, expectedReadyDate])
}

model ProductionTask {
  id           String               @id @default(cuid())
  title        String
  type         ProductionTaskType   @default(OTHER)
  status       ProductionTaskStatus @default(OPEN)
  dueAt        DateTime?
  workerNote   String?
  completedAt  DateTime?
  batchId      String?
  batch        ProductionBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  assignedToId String
  assignedTo   User                 @relation("ProductionTaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    User                 @relation("ProductionTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([assignedToId, status, dueAt])
  @@index([batchId, createdAt])
}

model ProductionCareLog {
  id           String            @id @default(cuid())
  batchId      String
  batch        ProductionBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  type         ProductionCareType
  performedAt  DateTime
  note         String?
  recordedById String
  recordedBy   User              @relation("ProductionCareRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())

  @@index([batchId, performedAt])
}

model ProductionLoss {
  id           String           @id @default(cuid())
  batchId      String
  batch        ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantity     Int
  reason       String
  occurredAt   DateTime
  reportedById String
  reportedBy   User             @relation("ProductionLossReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now())

  @@index([batchId, occurredAt])
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  code            String              @unique
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status          PurchaseOrderStatus @default(DRAFT)
  createdAt       DateTime            @default(now())
  sentAt          DateTime?
  receivedAt      DateTime?
  requestedById   String?
  requestedBy     User?               @relation("PurchaseRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedBy      User?               @relation("PurchaseApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?               @relation("PurchaseRejector", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectedAt      DateTime?
  rejectionReason String?
  sentById        String?
  sentBy          User?               @relation("PurchaseSender", fields: [sentById], references: [id], onDelete: Restrict)
  lines           PurchaseOrderLine[]
  receipts        PurchaseReceipt[]
  invoices        SupplierInvoice[]
  returns         SupplierReturn[]

  @@index([status, createdAt])
}

model AdjustmentRequest {
  id            String                  @id @default(cuid())
  productId     String
  product       Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  type          MovementType
  quantity      Int
  reason        String
  location      String
  status        AdjustmentRequestStatus @default(PENDING)
  requestedById String
  requestedBy   User                    @relation("AdjustmentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById  String?
  approvedBy    User?                   @relation("AdjustmentApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedById  String?
  rejectedBy    User?                   @relation("AdjustmentRejector", fields: [rejectedById], references: [id], onDelete: Restrict)
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime                @default(now())
  movement      InventoryMovement?
  stockCount    StockCount?

  @@index([status, createdAt])
  @@index([productId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  entity    String
  entityId  String
  details   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}

model PurchaseOrderLine {
  id                  String                @id @default(cuid())
  orderId             String
  order               PurchaseOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity            Int
  unitPrice           Decimal               @db.Decimal(12, 3)
  supplierQuoteLineId String?
  supplierQuoteLine   SupplierQuoteLine?    @relation(fields: [supplierQuoteLineId], references: [id], onDelete: Restrict)
  movement            InventoryMovement?
  receiptLines        PurchaseReceiptLine[]

  @@index([supplierQuoteLineId])
}

model SupplierQuote {
  id           String              @id @default(cuid())
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  reference    String
  quoteDate    DateTime            @default(now())
  validUntil   DateTime?
  note         String?
  recordedById String
  recordedBy   User                @relation("SupplierQuoteRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime            @default(now())
  lines        SupplierQuoteLine[]

  @@unique([supplierId, reference])
  @@index([supplierId, quoteDate])
}

model SupplierQuoteLine {
  id         String              @id @default(cuid())
  quoteId    String
  quote      SupplierQuote       @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  productId  String
  product    Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitPrice  Decimal             @db.Decimal(12, 3)
  orderLines PurchaseOrderLine[]

  @@unique([quoteId, productId])
}

model PurchaseReceipt {
  id              String                @id @default(cuid())
  code            String                @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedById    String
  receivedBy      User                  @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt      DateTime              @default(now())
  note            String?
  lines           PurchaseReceiptLine[]

  @@index([purchaseOrderId, receivedAt])
}

model PurchaseReceiptLine {
  id                  String              @id @default(cuid())
  receiptId           String
  receipt             PurchaseReceipt     @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine   @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  receivedQuantity    Int
  damagedQuantity     Int
  movements           InventoryMovement[]

  @@unique([receiptId, purchaseOrderLineId])
}

model SupplierInvoice {
  id              String                @id @default(cuid())
  supplierId      String
  supplier        Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  reference       String
  invoiceDate     DateTime?
  totalAmount     Decimal?              @db.Decimal(12, 3)
  note            String?
  status          SupplierInvoiceStatus @default(RECORDED)
  recordedById    String
  recordedBy      User                  @relation("SupplierInvoiceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  reviewedById    String?
  reviewedBy      User?                 @relation("SupplierInvoiceReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())
  payments        SupplierPayment[]

  @@unique([supplierId, reference])
  @@index([status, createdAt])
}

model SupplierPayment {
  id                String                 @id @default(cuid())
  supplierInvoiceId String
  supplierInvoice   SupplierInvoice        @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)
  amount            Decimal                @db.Decimal(12, 3)
  method            AccountingPaymentMethod
  reference         String?
  paidAt            DateTime               @default(now())
  recordedById      String
  recordedBy        User                   @relation("SupplierPaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  cashSessionId     String?
  cashSession       CashSession?           @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  cashEntry         CashLedgerEntry?

  @@index([supplierInvoiceId, paidAt])
}

model Expense {
  id           String        @id @default(cuid())
  category     String
  description  String
  amount       Decimal       @db.Decimal(12, 3)
  incurredAt   DateTime
  status       ExpenseStatus @default(PENDING_APPROVAL)
  requestedById String
  requestedBy   User         @relation("ExpenseRecorder", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById String?
  reviewedBy   User?         @relation("ExpenseReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime      @default(now())
  payments     ExpensePayment[]

  @@index([status, incurredAt])
}

model ExpensePayment {
  id            String                 @id @default(cuid())
  expenseId     String
  expense       Expense                @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  amount        Decimal                @db.Decimal(12, 3)
  method        AccountingPaymentMethod
  reference     String?
  paidAt        DateTime               @default(now())
  recordedById  String
  recordedBy    User                   @relation("ExpensePaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  cashSessionId String?
  cashSession   CashSession?           @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  cashEntry     CashLedgerEntry?

  @@index([expenseId, paidAt])
}

model VatRate {
  id          String   @id @default(cuid())
  name        String
  percentage  Decimal  @db.Decimal(5, 2)
  effectiveFrom DateTime
  effectiveTo DateTime?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name, effectiveFrom])
}

model SupplierReturn {
  id                String               @id @default(cuid())
  supplierId        String
  supplier          Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplierReference String?
  reason            String
  note              String?
  status            SupplierReturnStatus @default(PENDING_APPROVAL)
  requestedById     String
  requestedBy       User                 @relation("SupplierReturnRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById      String?
  reviewedBy        User?                @relation("SupplierReturnReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime             @default(now())
  lines             SupplierReturnLine[]

  @@index([status, createdAt])
  @@index([supplierId, createdAt])
}

model SupplierReturnLine {
  id             String         @id @default(cuid())
  returnId       String
  supplierReturn SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int

  @@unique([returnId, productId])
}

model StockCount {
  id                  String             @id @default(cuid())
  productId           String
  product             Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  location            String
  systemQuantity      Int
  countedQuantity     Int
  reason              String
  recordedById        String
  recordedBy          User               @relation("StockCountRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  adjustmentRequestId String?            @unique
  adjustmentRequest   AdjustmentRequest? @relation(fields: [adjustmentRequestId], references: [id], onDelete: Restrict)
  createdAt           DateTime           @default(now())

  @@index([productId, location, createdAt])
}

model Sale {
  id                 String                      @id @default(cuid())
  code               String                      @unique
  customerId         String
  customer           Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment            PaymentStatus
  approvalStatus     SaleApprovalStatus          @default(APPROVED)
  reviewedById       String?
  reviewedBy         User?                       @relation("SaleReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt         DateTime?
  reviewNote         String?
  cashSessionId      String?
  cashSession        CashSession?                @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  createdAt          DateTime                    @default(now())
  createdById        String?
  createdBy          User?                       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines              SaleLine[]
  paymentAllocations CustomerPaymentAllocation[]
  returns            SalesReturn[]
  cashEntry          CashLedgerEntry?

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([approvalStatus, createdAt])
}

model CustomerPayment {
  id            String                      @id @default(cuid())
  customerId    String
  customer      Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount        Decimal                     @db.Decimal(12, 3)
  method        AccountingPaymentMethod     @default(CASH)
  reference     String?
  note          String?
  receivedAt    DateTime                    @default(now())
  recordedById  String?
  recordedBy    User?                       @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  cashSessionId String?
  cashSession   CashSession?                @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  allocations   CustomerPaymentAllocation[]
  cashEntry     CashLedgerEntry?

  @@index([customerId, receivedAt])
}

model CustomerPaymentAllocation {
  id        String          @id @default(cuid())
  paymentId String
  payment   CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  saleId    String?
  sale      Sale?           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  amount    Decimal         @db.Decimal(12, 3)

  @@index([saleId])
}

model SaleLine {
  id          String              @id @default(cuid())
  saleId      String
  sale        Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  unitPrice   Decimal             @db.Decimal(12, 3)
  movements   InventoryMovement[]
  returnLines SalesReturnLine[]
}

model CashSession {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation("CashSessionOwner", fields: [userId], references: [id], onDelete: Restrict)
  openedAt     DateTime          @default(now())
  openingFloat Decimal           @db.Decimal(12, 3)
  closedAt     DateTime?
  closedById   String?
  closedBy     User?             @relation("CashSessionCloser", fields: [closedById], references: [id], onDelete: Restrict)
  closingCash  Decimal?          @db.Decimal(12, 3)
  expectedCash Decimal?          @db.Decimal(12, 3)
  variance     Decimal?          @db.Decimal(12, 3)
  reviewedById String?
  reviewedBy   User?              @relation("CashSessionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime?
  reviewNote   String?
  varianceApprovedById String?
  varianceApprovedBy   User?      @relation("CashVarianceApprover", fields: [varianceApprovedById], references: [id], onDelete: Restrict)
  varianceApprovedAt   DateTime?
  sales        Sale[]
  payments     CustomerPayment[]
  returns      SalesReturn[]     @relation("ReturnCashSession")
  entries      CashLedgerEntry[]
  supplierPayments SupplierPayment[]
  expensePayments  ExpensePayment[]

  @@index([userId, openedAt])
  @@index([closedAt, openedAt])
}

model CashLedgerEntry {
  id                String              @id @default(cuid())
  sessionId         String
  session           CashSession         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  type              CashLedgerEntryType
  amount            Decimal             @db.Decimal(12, 3)
  reason            String?
  createdById       String
  createdBy         User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  saleId            String?             @unique
  sale              Sale?               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customerPaymentId String?             @unique
  customerPayment   CustomerPayment?    @relation(fields: [customerPaymentId], references: [id], onDelete: Restrict)
  salesReturnId     String?             @unique
  salesReturn       SalesReturn?        @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  supplierPaymentId String?             @unique
  supplierPayment   SupplierPayment?    @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  expensePaymentId  String?             @unique
  expensePayment    ExpensePayment?     @relation(fields: [expensePaymentId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())

  @@index([sessionId, createdAt])
}

model SalesReturn {
  id               String            @id @default(cuid())
  code             String            @unique
  saleId           String
  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  status           SalesReturnStatus @default(PENDING)
  reason           String
  requestedById    String
  requestedBy      User              @relation("ReturnRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById     String?
  approvedBy       User?             @relation("ReturnApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedById     String?
  rejectedBy       User?             @relation("ReturnRejector", fields: [rejectedById], references: [id], onDelete: Restrict)
  verifiedById     String?
  verifiedBy       User?             @relation("ReturnVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  reviewNote       String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  verifiedAt       DateTime?
  cashRefundAmount Decimal           @default(0) @db.Decimal(12, 3)
  cashSessionId    String?
  cashSession      CashSession?      @relation("ReturnCashSession", fields: [cashSessionId], references: [id], onDelete: Restrict)
  cashEntry        CashLedgerEntry?
  createdAt        DateTime          @default(now())
  lines            SalesReturnLine[]

  @@index([status, createdAt])
  @@index([saleId, createdAt])
}

model SalesReturnLine {
  id                String             @id @default(cuid())
  returnId          String
  salesReturn       SalesReturn        @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleLineId        String
  saleLine          SaleLine           @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  quantity          Int
  restockedQuantity Int?
  movement          InventoryMovement?

  @@unique([returnId, saleLineId])
}
